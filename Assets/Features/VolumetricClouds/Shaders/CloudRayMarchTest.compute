// Cloud Ray Marching — Compute Shader
// Nubis 风格 2.5D 体积云：全屏 dispatch，沿视线对球壳云层做深度 marching。
// 每个像素：重建射线 → 云层相交 → 形状采样 → Beer-Lambert 光照 → 输出散射色 + 不透明度。
//
// 输入: _CameraDepthTexture（深度提前退出）
// 输出: _CloudTarget (RWTexture2D, RGBA: RGB=散射色, A=云不透明度)

#pragma enable_d3d11_debug_symbols
#pragma only_renderers d3d11 vulkan metal
#pragma kernel CSMain

#include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/Lighting.hlsl"
#include "Assets/Features/VolumetricClouds/Shaders/CloudLighting.hlsl"

// https://www.scratchapixel.com/lessons/3d-basic-rendering/minimal-ray-tracer-rendering-simple-shapes/ray-sphere-intersection
float3 findRayStartPos(float3 rayOrigin, float3 rayDirection, float3 sphereCenter, float radius)
{
    float3 l = rayOrigin - sphereCenter;
    float a = 1.0;
    float b = 2.0 * dot(rayDirection, l);
    float c = dot(l, l) - pow(radius, 2);
    float D = pow(b, 2) - 4.0 * a * c;
    if (D < 0.0)
    {
        return rayOrigin;
    }
    if (abs(D) - 0.00005 <= 0.0)
    {
        return rayOrigin + rayDirection * (-0.5 * b / a);
    }
    float q = 0.0;
    if (b > 0.0)
    {
        q = -0.5 * (b + sqrt(D));
    }
    else
    {
        q = -0.5 * (b - sqrt(D));
    }
    float h1 = q / a;
    float h2 = c / q;
    float2 t = float2(min(h1, h2), max(h1, h2));
    if (t.x < 0.0)
    {
        t.x = t.y;
        if (t.x < 0.0)
        {
            return rayOrigin;
        }
    }
    return rayOrigin + t.x * rayDirection;
}


// ── 输入参数（由 C# RenderFeature 每帧 SetGlobal 填充）───────────────────
RWTexture2D<float4> _CloudTarget;
float _CloudLightingMode; // 光照模式（VolumetricCloudFeature.CloudLightingMode）：0=BeerLambert 光锥，1=Hillaire MS 方式 B
float _TimeSlicing; // 分帧渲染（棋盘格时间切片 + 重投影）：1=每帧只更新 1/N² 像素，0=全帧
float _InterleaveSize; // 分帧粒度 N（2=2×2 块，4=4×4 块）
float _DebugSlice; // [调试] 1=只显示本帧 march 的目标像素（非目标清透明，场景露出），0=正常
float _ReprojEdgeThreshold; // 重投影遮挡边缘阈值（3×3 深度跨度超过则保留原地——消云/地形缝隙）
float4x4 _NoJitterInvViewProj; // 非 jittered 逆 VP（C# 每帧设置）：TAA 开启时 UNITY_MATRIX_I_VP
// 每帧含 ±0.5px jitter，分帧模式下 march 视线/重投影/遮挡判断
// 用它会导致逐帧偏移（流动伪影）
float4x4 _NoJitterInvProj; // no-jitter 投影逆（C# 每帧设置）：viewDir 在相机空间重建近平面点用
//（UNITY_MATRIX_I_P 在 TAA 下含 jitter；相机空间坐标小，无 6e6 精度问题）
Texture2D<float4> _CloudTargetPrevTex; // 上一帧结果（只读，重投影双线性采样——消 prevUV 整数化条带）
// _PrevViewProjMatrix 由 URP Core.hlsl 声明（motion vector 支持），重投影直接使用

// ── 3×3 邻域偏移（最近深度选择用，TAA 防鬼影标准做法）──
static const float2 kOffsets3x3[9] = {
    float2(-1, -1), float2(0, -1), float2(1, -1),
    float2(-1, 0), float2(0, 0), float2(1, 0),
    float2(-1, 1), float2(0, 1), float2(1, 1)
};

// ── 分帧重投影 kernel：把上一帧结果按相机运动搬到当前帧位置 ──────────────
// 当前深度 → 世界位置 → 上一帧 VP 投影 → 采样 prev（视差正确，消除运动拖影）。
// 不做 far 特判：云层不写深度，云像素深度恒为 far，特判保留原地会让相机旋转时
// 云完全不搬移（粘屏拖影）。far 像素的 rawDepth 本身即 far 平面深度 → 反投影自然
// 落在 far 平面：平移时云视差≈0（prevUV≈当前 UV，退化为恒等），旋转时正确搬移。
#pragma kernel CSReproject
[numthreads(8, 8, 1)]
void CSReproject(uint3 id : SV_DispatchThreadID)
{
    // 3×3 最近深度选择（TAA 防鬼影标准做法）：深度不连续边缘用前景深度反投影，
    // 避免把背景内容搬到前景（转动时小鬼影点 + 几何边缘条纹）
    float bestDepth = 1.0f; // 归一化深度：1 = far（reversed 翻转后）
    uint2 bestPixel = id.xy;
    UNITY_UNROLL
    for (int k = 0; k < 9; k++)
    {
        uint2 sPixel = uint2(clamp((float2)id.xy + kOffsets3x3[k], 0.0, _ScreenParams.xy - 1.0));
        float d = LoadSceneDepth(sPixel);
        #if UNITY_REVERSED_Z
        d = 1.0 - d; // 转成"越大越远"，取最小 = 最近
        #endif
        if (d < bestDepth)
        {
            bestDepth = d;
            bestPixel = sPixel;
        }
    }

    // 深度不连续检测（3×3 深度跨度大 = 几何/遮挡边缘）：边缘像素保留原地——
    // 最近深度反投影会把边缘像素拉到地形 → 采样 prev 的被裁区（无云）→ 云/地形缝隙
    float depthMin = 1.0f, depthMax = 0.0f;
    UNITY_UNROLL
    for (int k = 0; k < 9; k++)
    {
        uint2 sPixel = uint2(clamp((float2)id.xy + kOffsets3x3[k], 0.0, _ScreenParams.xy - 1.0));
        float d = LoadSceneDepth(sPixel);
        depthMin = min(depthMin, d);
        depthMax = max(depthMax, d);
    }
    bool onOcclusionEdge = (depthMax - depthMin) > _ReprojEdgeThreshold;

    float2 bestUV = ((float2)bestPixel + 0.5) / _ScreenParams.xy;
    float rawDepth = LoadSceneDepth(bestPixel);
    // 与 CSMain 一致：非 reversed-Z 平台把 NDC 深度映射到 clip z（near~1）
    #if !UNITY_REVERSED_Z
    rawDepth = lerp(UNITY_NEAR_CLIP_VALUE, 1.0, rawDepth);
    #endif

    float3 posWS = ComputeWorldSpacePosition(bestUV, rawDepth, _NoJitterInvViewProj);
    float4 prevClip = mul(_PrevViewProjMatrix, float4(posWS, 1.0));
    // prevVP 是 CPU 约定矩阵（GetProjectionMatrix × GetViewMatrix），NDC y 向上，
    // ×0.5+0.5 得 v=0 底部的屏幕坐标——与 Unity compute 的 Load/Store 坐标约定一致
    //（CSMain 的 LoadSceneDepth / 写 _CloudTarget 同约定）。不能做 UNITY_UV_STARTS_AT_TOP
    // 翻转，否则 y 镜像 → 重投影内容与 march 内容上下错位（对称云）。
    float2 prevUV = prevClip.xy / prevClip.w * 0.5 + 0.5;
    // 裁剪检查：上一帧视野外（prevClip.w ≤ 0 或超出屏幕）或遮挡边缘 → 保留原地（prev 同位置）
    float2 uv = ((float2)id.xy + 0.5) / _ScreenParams.xy;
    float4 prev = _CloudTargetPrevTex.SampleLevel(sampler_LinearClamp, uv, 0); // 默认保留上一帧同位置值
    if (!onOcclusionEdge && prevClip.w > 0 && all(prevUV > 0.0) && all(prevUV < 1.0))
    {
        prev = _CloudTargetPrevTex.SampleLevel(sampler_LinearClamp, prevUV, 0); // 双线性采样（消整数化条带）
    }
    _CloudTarget[id.xy] = prev;
}

// ── 分帧轮换 LUT：帧号 t → 块内偏移（对角线/十字散布顺序）。
// 避免行主序（t%n, t/n）的水平扫描带——更新像素成带扫过屏幕，
// 新旧值差异呈定向"流动"伪影；散布顺序让差异随机化（无方向）。
// 表为 frameBlockN 的反查（原索引 → 新索引，双射：覆盖率/收敛帧数不变）。
// 注意：LUT 必须在全局作用域（函数内 static const 数组在 D3D11 编译失败 → kernel invalid）
static const uint kLut2[4] = {0, 3, 1, 2}; // frameBlock2X2 反查：t→(x,y) 为 (0,0)(1,1)(1,0)(0,1)
static const uint kLut4[16] = {0, 10, 2, 8, 5, 15, 7, 13, 1, 11, 3, 9, 4, 14, 6, 12}; // 前 8 帧对角/十字，后 8 帧填剩余

uint2 GetInterleaveOffset(uint t, uint n)
{
    if (n == 2)
    {
        uint idx = kLut2[t];
        return uint2(idx % 2, idx / 2);
    }

    uint idx4 = kLut4[t];
    return uint2(idx4 % 4, idx4 / 4);
}

/// <summary>
///     视线方向反投影（no-jitter）：分步重建——投影逆在相机空间重建近平面点
///     （相机空间坐标小，float32 高精度；逆 VP 在世界坐标 6e6 量级重建 near 点
///     会被 ULP≈0.5m 量化 → 高空 viewDir 分层），再视图逆纯旋转转世界方向。
///     投影逆用 _NoJitterInvProj（UNITY_MATRIX_I_P 在 TAA 下含 jitter → 流动伪影）；
///     视图旋转用 UNITY_MATRIX_I_V（view 矩阵无 jitter）。
/// </summary>
float3 GetViewDirNoJitter(float2 uv)
{
    float nearDepth = UNITY_REVERSED_Z ? 1.0 : 0.0;
    float2 ndc = uv * 2.0 - 1.0;
    #if UNITY_UV_STARTS_AT_TOP
    ndc.y = -ndc.y;
    #endif
    float4 viewPos = mul(_NoJitterInvProj, float4(ndc, nearDepth, 1.0));
    float3 dirCS = viewPos.xyz / max(viewPos.w, 1e-6); // 相机空间方向（近平面小量，高精度）
    return normalize(mul((float3x3)UNITY_MATRIX_I_V, dirCS)); // 纯旋转转世界方向（view 无 jitter）
}

// ── Main Kernel ──────────────────────────────────────────────────────────
[numthreads(8, 8, 1)]
void CSMain(uint3 id : SV_DispatchThreadID)
{
    // ── 分帧渲染（棋盘格时间切片）：每帧只更新 1/N² 像素（N×N 块取一角，N² 帧轮换），
    // 其余像素由重投影 pass 提供（上一帧结果按相机运动搬移）→ 无拖影；
    // 输出处与重投影后的旧值混合
    uint2 screenPos;
    if (_TimeSlicing > 0.5)
    {
        screenPos = id.xy; // 全屏 dispatch：每个像素自行判断本帧是否目标
        uint n = uint(_InterleaveSize); // 2 或 4
        uint t = uint(_FrameCount) % (n * n);
        uint2 offset = GetInterleaveOffset(t, n); // 对角/十字散布（LUT），避免行主序扫描带 → 定向流动伪影
        if (any(id.xy % n != offset)) // 向量比较 → any：任一分量非目标即非本帧目标像素
        {
            // 非目标像素不写——保留重投影（CSReproject）已写入的搬移旧值
            if (_DebugSlice > 0.5)
                _CloudTarget[screenPos] = float4(0, 0, 0, 0); // [调试] 清透明，只显示本帧 march 的 1/N²
            return;
        }
    }
    else
    {
        screenPos = id.xy;
    }

    // UV 保持官方约定（v=0 底部）；GetViewDir/ComputeWorldSpacePosition 内部各自按
    // UNITY_UV_STARTS_AT_TOP 处理翻转，这里不要动 uv
    float2 uv = (float2(screenPos) + 0.5) / _ScreenParams.xy;

    // Load 整数坐标（全屏 compute 不需要插值）；反 Z 平台深度值即 clip z，GL 需转 -1..1
    float rawDepth = LoadSceneDepth(screenPos);
    // far 深度（无几何，如天空/行星球背面剔除）——不参与深度裁剪，
    // 否则相机在球内时 sceneDist（far 平面）远小于云层距离（r 量级）→ 云全被裁掉
    bool isFar = UNITY_REVERSED_Z ? rawDepth < 1e-5 : rawDepth > 1.0 - 1e-5;
    #if !UNITY_REVERSED_Z
    rawDepth = lerp(UNITY_NEAR_CLIP_VALUE, 1.0, rawDepth);
    #endif

    // 相机在世界坐标（世界 y = 海拔）；行星中心跟随相机水平位置（精度方案：
    // 相交在球坐标算 t（r 量级），密度采样在世界坐标（海拔小量，float32 高精度））
    float3 position = _WorldSpaceCameraPos;
    // 分帧：视线用 no-jitter 逆 VP（TAA 的 jitter 会让 UNITY_MATRIX_I_VP 每帧 ±0.5px →
    // 目标像素每次更新的 march 值在不同 jitter 下采样 → 流动伪影）；全帧保持 jittered（TAA 平滑）
    float3 viewDir = _TimeSlicing > 0.5 ? GetViewDirNoJitter(uv) : GetViewDir(uv, position);

    // _CloudTarget[id.xy] = float4(viewDir, 1);
    // return;
    float3 sphereCenter = float3(0, -_PlanetRadius, 0);

    RayMarchInfo info = GetRayMarchInfo();
    info.planetCenter = sphereCenter;

    float3 ro = position;
    float3 rd = viewDir;

    // [三态方案试验] 三态射线段已还原为 RayCloudLayerDst 统一相交（findRayStartPos 函数保留）
    // float3 rs;
    // float3 re;
    // float steps;
    // float stepSize;
    // bool aboveClouds = false;
    // float distanceCameraPlanet = distance(position, sphereCenter);
    // if (distanceCameraPlanet < info.planetRadius + info.cloudHeightRangeMinMax.x) // Below clouds
    // {
    //     rs = findRayStartPos(ro, rd, sphereCenter, info.planetRadius + info.cloudHeightRangeMinMax.x);
    //     if (rs.y < 0) { _CloudTarget[screenPos] = float4(0, 0, 0, 0); return; }
    //     re = findRayStartPos(ro, rd, sphereCenter, info.planetRadius + info.cloudHeightRangeMinMax.y);
    //     steps = lerp(_ShapeStepCount, _ShapeStepCount * 0.5, rd.y);
    //     stepSize = (distance(re, rs)) / steps;
    // }
    // else if (distanceCameraPlanet > info.planetRadius + info.cloudHeightRangeMinMax.y) // Above clouds
    // {
    //     rs = findRayStartPos(ro, rd, sphereCenter, info.planetRadius + info.cloudHeightRangeMinMax.y);
    //     re = rs + rd * _ProjectionParams.z;
    //     steps = lerp(_ShapeStepCount, _ShapeStepCount * 0.5, rd.y);
    //     stepSize = (distance(re, rs)) / steps;
    //     aboveClouds = true;
    // }
    // else // In clouds
    // {
    //     rs = ro;
    //     re = rs + rd * _ProjectionParams.z;
    //     steps = lerp(_ShapeStepCount, _ShapeStepCount * 0.5, rd.y);
    //     stepSize = (distance(re, rs)) / steps;
    // }

    // 云层相交（CloudCommon.hlsl）——返回 (到云层距离, 云层内厚度)
    float2 cloudDst = RayCloudLayerDst(sphereCenter, _PlanetRadius, _CloudHeightMin, _CloudHeightMax,
                                       position, viewDir, true);
    if (cloudDst.y <= 0)
    {
        _CloudTarget[screenPos] = float4(0, 0, 0, 0);
        return;
    }

    float dstToCloud = cloudDst.x;
    float endPos = dstToCloud + cloudDst.y; // 出云点

    // 地平线剔除（Nathan Vos 优化）：视线先碰到地球表面 → 云被地球遮挡，直接跳过
    // 相机在行星球内：d1 < 0（后方）、d2 > 0（穿出距离）；球外：d1 = 首次进入距离；无交点：-1
    float2 earthHit = RaySphereIntersection(position, viewDir, sphereCenter, _PlanetRadius);
    float earthDist = earthHit.x > 0 ? earthHit.x : earthHit.y;
    if (earthDist > 0 && earthDist < dstToCloud)
    {
        _CloudTarget[screenPos] = float4(0, 0, 0, 0);
        return;
    }

    // ── 参考实现深度转换（待拼接）────────────────────────────
    // 深度纹理（非线性）→ 线性 0~1 → × 远裁剪面 = 视空间 z 距离（米）
    // far 深度（无几何）映射到 100×远裁剪面 → 天空像素不裁剪云（粗糙 hack）
    // 注意：视空间 z ≠ 射线距离 t，斜视边缘偏差 1/cosθ（参考未修正，拼接时注意）
    float depthRef = Linear01Depth(LoadSceneDepth(screenPos), _ZBufferParams);
    if (depthRef == 1.0)
    {
        depthRef = 500.0;
    }
    depthRef *= _ProjectionParams.z;

    // 深度提前退出：云被不透明几何遮挡的部分直接跳过
    // eye depth 是视线方向投影距离 ≠ 射线 t，边缘像素偏差 1/cosθ，需重建世界位置算真实距离
    float tExit = endPos;
    float sceneDist = 1e9; // 场景距离（far 像素用大值不裁剪）
    if (!isFar)
    {
        float3 scenePosWS = ComputeWorldSpacePosition(uv, rawDepth, _NoJitterInvViewProj);
        sceneDist = distance(scenePosWS, position); // 与 march 的 t 同参考系
        tExit = min(tExit, sceneDist);
    }

    if (tExit <= dstToCloud)
    {
        _CloudTarget[screenPos] = float4(0, 0, 0, 0);
        return;
    }

    //获取灯光信息
    Light mainLight = GetMainLight();
    float3 lightDir = normalize(mainLight.direction);

    // compute 中必须用 _LOD（SampleLevel）——SAMPLE_TEXTURE2D 的 Sample() 依赖自动 mip，cs_5_0 无法映射
    float IGN = InterleavedGradientNoise(screenPos, _FrameCount);

    // ── 距离自适应步长（几何增长，maxStep=500m）─────────────────
    // 步长随行进距离平滑增长（几何级数，无跳变）：近处 180m 起步（云间近处细节），
    // 远处封顶 500m（500m 步长已验证无断裂——密度结构几百米~km 尺度下采样平滑）。
    // 相切带（水平视线贴球壳，路径 100km+）步长同样被 500m 钳制 → 无切线方向伪影。
    // 预算：云下远处 200km 路径 ≈ 增长 10 步 + 197km/500m = 394 步 + 空区 60 ≈ 465 < 512 ✓
    float ds = (tExit - dstToCloud) / _ShapeStepCount;
    float minStep = min(ds, _LightStepLength);
    const float kStepGrowth = 0.1;
    const float maxStep = 500.0;

    float cosTheta = dot(viewDir, lightDir);
    // 每 octave 相位（Hillaire MS，CloudLighting.hlsl）：
    // octave 0 = 双 lobe max（主前向 + 银边）——单散射峰值，保留银边；
    // 高阶 octave 仅主 lobe，偏心率按 _MSEccentricity^o 衰减（多次散射趋于各向同性，银边不参与）
    float3 phase;
    phase[0] = GetDirectScatterProbability(_MieG, cosTheta);
    phase[1] = HenyeyGreenstein(cosTheta, _MieG * _MSEccentricity);
    phase[2] = HenyeyGreenstein(cosTheta, _MieG * _MSEccentricity * _MSEccentricity);

    float3 color = float3(0, 0, 0);
    float tau_PA = 0;
    // ── 自适应形状 march（Nubis 2017 状态机）──────────────────────────
    // 云外：判断采样 + 大步幅跳过（2×步长），检测到云后退一步防越界，切细步进；
    // 云内：细步进全采样 + 圆锥光照；连续零密度 ≥ 11 判定穿出云层，切回大步。
    // 注：暂无 doCheaply/LOD，云外判断也用完整采样（正确性优先），后续补 cheap 模式。
    float t = dstToCloud + minStep * IGN; // 入云点 + 抖动（≤1 细步）
    float stepSize = minStep;
    bool inCloud = false;
    int zeroDensityCount = 0;
    float prevDensity = -1.0;
    float alpha = 0.0;

    // 步数上限 ×8（512）：自适应 maxStep=500m 下云下远处 200km 路径 ≈ 465 步，
    // 256 会截断云层后半段，512 兜底；普通视角步数不变
    for (int i = 0; i < (int)_ShapeStepCount * 8 && alpha <= 1.0 && t < tExit; i++)
    {
        // 自适应步长（几何级数，无跳变）。云内以"云内深度"为基准重新增长：
        // 否则高空相机空区让 t 巨大 → 云内步长直接 clamp 到 maxStep
        stepSize = clamp((inCloud ? t - dstToCloud : t) * kStepGrowth, minStep, maxStep);
        if (!inCloud)
        {
            // 云外：判断采样（cheap，跳过高频细节噪声）+ 大步跳过
            float3 probeWS = position + viewDir * (t + stepSize);

            if (distance(position, probeWS) >= depthRef)
            {
                break; // if it is then raymarch ends
            }

            if (SampleCloudDensity(probeWS, info, true).density <= 0.0)
            {
                // 空区大步跳过：初始空区（t < 入点）直接逼近云层入点——
                // 99km 高空云顶边缘带空区可达 400~1000km，一步步跳（2km/步）会耗尽
                // 256 步预算 → 云顶边缘像素截断 → 锯齿阶梯；已进入过云层
                // （t > 入点，云层断裂区）保持原大步，避免倒退死循环。
                // 钳制到入点前一个细步（非入点本身）：贴云顶飞行（10km 时距云顶球仅
                // ~900m）时 probe 以细步逼近边缘，march 起点连续 → 边缘长条状破裂/乱抖
                t = (t < dstToCloud) ? min(t + stepSize * 2.0, dstToCloud - minStep) : t + stepSize * 2.0;
                continue;
            }
            // 检测到云：后退一步，切细步进
            t -= stepSize;
            inCloud = true;
            zeroDensityCount = 0;
            prevDensity = -1.0;
            continue;
        }

        // 云内：
        float3 posWS = position + viewDir * (t + stepSize);
        CloudInfo cloudInfo = SampleCloudDensity(posWS, info, false);
        float absorption = cloudInfo.absorptivity;
        float density = cloudInfo.density;

        // 零密度计数（连续两次零才 +1，计数只增不减，Nubis 出云判定）
        if (density <= 0.0 && prevDensity <= 0.0)
            zeroDensityCount++;
        prevDensity = density;

        if (zeroDensityCount >= 11)
        {
            // 判定已穿出云层 → 切回大步模式
            inCloud = false;
            zeroDensityCount = 0;
            prevDensity = -1.0;
            continue;
        }

        if (density > 0.0)
        {
            alpha += density;
            // 降雨吸收：放大消光（散射不变 → 云更暗），吸收率来自天气图 G 通道
            float extinction = _ExtinctionCoeff * lerp(1.0, _AbsorptionStrength, absorption);
            tau_PA += extinction * density * stepSize;
            float T_PA = exp(-tau_PA);

            // ── 圆锥采样（点到光源光学深度 dl，Nubis 2017 Cone Sampling）──
            // 6 个噪声方向使锥形样本错开（抗对齐伪影），半径随步进递增 → 锥形；
            // 累积密度 < 0.3 用全采样，超过切 cheap（参考的 0.3 阈值，优化）
            static float3 noise_kernel[6] =
            {
                float3(0.38051305, 0.92453449, -0.02111345),
                float3(-0.50625799, -0.03590792, -0.86163418),
                float3(-0.32509218, -0.94557439, 0.01428793),
                float3(0.09026238, -0.27376545, 0.95755165),
                float3(0.28128598, 0.42443639, -0.86065785),
                float3(-0.16852403, 0.14748697, 0.97460106)
            };

            float3 samplePos = posWS; // 保存当前采样点（cone 循环推进自己的副本）
            // 光步长固定 _LightStepLength（参考 sampleConeToLight）——视步长在地平线处
            // 暴涨，光步跟它走会让 τ_CP 爆炸（云发黑）；锥形半径用 _LightConeRadius × (j+1)
            float3 lightStep = _LightStepLength * lightDir;
            float tau_CP = 0.0;

            float3 conePos = samplePos;
            for (int j = 0; j < 6; j++) // j < 6，避免 noise_kernel 越界
            {
                // 参考偏移：noise_kernel[j] × 光步长 × 锥形半径 × (j+1)（半径随步进递增 → 锥形）
                float3 p = conePos + noise_kernel[j] * _LightStepLength * _LightConeRadius * float(j + 1);
                // 累积密度 < 0.3 全采样，超过切 cheap（struct 不能用于三元，用 if/else）
                CloudInfo coneInfo;
                if (density < 0.3)
                    coneInfo = SampleCloudDensity(p, info, false);
                else
                    coneInfo = SampleCloudDensity(p, info, true);
                // 光学深度按光步长累积（与锥形推进一致）
                tau_CP += coneInfo.density * _LightStepLength * extinction;
                conePos += lightStep;
            }

            // T_CP：大气段（点到光源 LUT）——云段单散射透射 exp(-τ_CP) 已在 J 内算完
            float3 T_CP = EvaluateAtmosphereTransmittance(samplePos, sphereCenter, lightDir);
            float heightFraction = GetHeightFractionForPoint(sphereCenter, info.planetRadius, samplePos,
                                                             info.cloudHeightRangeMinMax);

            // ── 光照模式（_CloudLightingMode，Inspector VolumetricCloudFeature → Lighting Mode）──
            if (_CloudLightingMode < 0.5)
            {
                // 模式 0：BeerLambert 光锥（参考 calculateLightEnergy）：beerLaw 吃锥形光路累积密度
                //（自阴影），powder 吃当前点密度；双 HG 相位 max(HG(fwd), HG(-bwd))×0.6909+0.8；
                // 大气段透射 T_CP（查 _OpticalDepthLUT）：太阳光穿过大气到达云点的衰减，
                // 不加会导致低太阳角时云比天空亮、日落不变红
                float3 lighting = 2 * BeerLambert(tau_CP, _Density) * PowderEffect(density, cosTheta) *
                    GetDualHGPhase(cosTheta) * _SunColor * _SunIntensity * T_CP * 0.3;
                // 大气 LUT 环境光（与天空盒同源）：云顶受天顶天空照亮（upwardAO：
                // 光路光学深度 × sin(太阳仰角) 估算上方云遮蔽，HP 思路）；云底受地面方向照亮，随高度混合
                float3 ambientTop = SampleSkyViewLut(float3(0, 1, 0));
                float3 ambientBottom = SampleSkyViewLut(float3(0, -1, 0));
                float sinElev = max(lightDir.y, 0.05);
                float upwardAO = exp(-tau_CP * sinElev);
                float3 ambientLighting =
                    (ambientTop * upwardAO + ambientBottom * (1.0 - heightFraction)) * _AmbientLightFactor;
                // 累积权重：本步新增不透明度 Δτ = 1-exp(-σt·ρ·ds)
                // 之前用 (1-T_PA)（总不透明度）做权重：首步 T_PA≈1 → 权重≈0，近处云贡献最少——物理反了；
                // 参考用预乘 alpha（权重 = 粒子密度），Beer 透射模型对应权重 = Δτ
                float stepOpacity = 1.0 - exp(-extinction * density * stepSize);
                color += (lighting + ambientLighting) * T_PA * stepOpacity;
            }
            else
            {
                // 模式 1：Hillaire MS 方式 B——对齐大气 scatter += I × (J × T_CP + ms) × T_PA × ds
                // J = 单散射项 = 散射核 × phase[0]（含银边）× exp(-τ_CP)（EvaluateCloudInScattering）；
                // kernel（out 参数）：散射核（σs·ρ·S），J 与 ms 共享（HDRP 同构：density·σs 作用于全部 octave）
                // ms = 多次散射补益项：octave 从 1 起（octave 0 已在 J 内），薄云 τ_CP→0 时 ms 随 kernel 归零
                float kernel;
                float J = EvaluateCloudInScattering(density, _ScatterCoeff, phase, tau_CP, stepSize,
                                                    heightFraction, kernel);
                float3 ms = 0;
                [unroll]
                for (int o = 1; o < NUM_MULTI_SCATTERING_OCTAVES; ++o)
                {
                    float att = pow(_MSAttenuation, (float)o);
                    float con = pow(_MSContribution, (float)o);
                    ms += kernel * exp(-tau_CP * att) * phase[o] * con;
                }
                color += _SunIntensity * _SunColor * (J * T_CP + ms) * T_PA * stepSize;
            }
            if (T_PA <= 0.01)
            {
                break;
            }
        }
        t += stepSize;
    }

    // alpha 增强（艺术补偿）：消光参数量级低（_ExtinctionCoeff 0.0035 × density≤0.1 →
    // 8km 厚云 τ_a≤2.8 → alpha≤0.94，均值 alpha 仅 0.5-0.8），合成 lerp 时透出大气天空。
    // 物理 σt 应高 10-100 倍，但直接调 extinction 会同步压暗光照（Beer 自阴影），
    // 故仅增强 alpha 输出：τ_a × 3 → 全密云 alpha≈1，光照路径不动。
    // 分帧：直接覆盖（不混合）——重投影已把旧帧搬到正确位置，棋盘格 N² 帧轮换下
    // 每像素 N² 帧内必然被 march 覆盖一次 → 完整；混合 0.5 会让收敛极慢（每 N² 帧
    // 只推进 50%）→ 云持续变淡
    _CloudTarget[screenPos] = float4(color, 1.0 - exp(-tau_PA));
}
